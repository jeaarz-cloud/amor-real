generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
}

model Miembro {
  id            String   @id @default(cuid())
  email         String   @unique
  nombre        String?
  createdAt     DateTime @default(now())
}

model VideoIA {
  id            String   @id @default(cuid())
  miembroId     String
  idea          String
  cancionUrl    String?
  videoUrl      String?
  estado        String   @default("generando")
  createdAt     DateTime @default(now())
}